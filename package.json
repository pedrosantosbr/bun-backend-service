{
  "name": "@template/root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "sideEffects": false,
  "scripts": {
    "postinstall": "lefthook install",
    "dev": "bun --hot packages/api/src/dev.ts",
    "worker": "bun run scripts/local-worker.ts",
    "deps:up": "docker compose up -d --wait",
    "deps:down": "docker compose down",
    "db:push": "bun run --cwd packages/core db:push",
    "typecheck": "tsc -p . --noEmit",
    "typecheck:infra": "tsc -p infra/tsconfig.json --noEmit",
    "lint": "oxlint -c .oxlintrc.json",
    "lint:fix": "oxlint -c .oxlintrc.json --fix",
    "lint:forbidden": "sh -c 'rg -n -F \"Effect.promise(\" packages --glob \"!**/*.test.ts\" --glob \"!**/docs/**\"; code=$?; if [ \"$code\" = 0 ]; then echo \"Forbidden: Effect.promise (use Effect.tryPromise)\"; exit 1; elif [ \"$code\" != 1 ]; then exit \"$code\"; fi; rg -n -F \"await import(\" packages --glob \"!**/*.test.ts\" --glob \"!**/docs/**\"; code=$?; if [ \"$code\" = 0 ]; then echo \"Forbidden: await import (use static imports)\"; exit 1; elif [ \"$code\" = 1 ]; then exit 0; else exit \"$code\"; fi'",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "sh -c 'bun test $(rg --files -g \"*.test.ts\" -g \"!*.integration.test.ts\" packages)'",
    "test:integration": "sh -c 'bun test --timeout=40000 $(rg --files -g \"*.integration.test.ts\" packages)'",
    "check": "bun run scripts/check.ts",
    "docs:dev": "bun run --cwd packages/docs dev",
    "docs:build": "bun run --cwd packages/docs build"
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "catalog:",
    "@template/functions": "workspace:*",
    "@tsconfig/node22": "22.0.2",
    "@types/bun": "catalog:",
    "lefthook": "2.1.6",
    "oxfmt": "0.24.0",
    "oxlint": "1.39.0",
    "sst": "catalog:",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "catalog": {
    "@aws-sdk/client-sqs": "3.848.0",
    "@effect/platform": "0.93.2",
    "@hono/zod-validator": "0.7.4",
    "@types/aws-lambda": "8.10.155",
    "@types/bun": "latest",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "effect": "3.19.3",
    "hono": "4.10.7",
    "mongoose": "8.4.1",
    "pg": "8.17.1",
    "sst": "3.17.23",
    "uuid": "11.1.0",
    "zod": "4.1.12"
  }
}
