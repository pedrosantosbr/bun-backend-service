# All values are optional for local dev — the defaults in
# packages/shared/src/config/app-config.ts already point at docker-compose.
# In deployed stages these are injected by SST (see infra/queues.ts).

STAGE=local
LOG_LEVEL=info

POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5433/template
MONGO_URL=mongodb://127.0.0.1:27018/template
TASK_QUEUE_URL=http://localhost:9324/000000000000/task-execution
# SQS_ENDPOINT is auto-defaulted to http://localhost:9324 when STAGE is local/test
#SQS_ENDPOINT=http://localhost:9324

# Leave unset to disable bearer auth locally
#API_TOKEN=

ECHO_PROVIDER_MODE=fake
ECHO_PROVIDER_BASE_URL=http://localhost:4010
#ECHO_PROVIDER_API_KEY=
ECHO_PROVIDER_TIMEOUT_MS=10000
